model Tenant {
    id                String   @id @default(uuid())
    slug              String   @unique
    name              String
    tagline           String?  @default("")
    initials          String?  @default("")
    accent            String?  @default("oklch(0.6 0.2 240)")
    currency          String   @default("USD")
    locale            String   @default("en-US")
    taxRate           Float    @default(0.1)
    serviceChargeRate Float    @default(0.0)
    receiptFooter     String?  @default("Thank you for dining with us!")

    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    roles             TenantRole[]
    staff             StaffMember[]

    @@map("tenants")
}

model TenantRole {
    id          String   @id @default(uuid())
    tenantId    String
    role        UserRole
    permissions String[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    staff       StaffMember[]

    @@unique([tenantId, role])
    @@map("tenant_roles")
}

model StaffMember {
    id                String   @id @default(uuid())
    tenantId          String
    userId            String?
    roleId            String
    role              UserRole
    name              String
    email             String?
    phone             String?
    hourlyRate        Float    @default(0.0)
    branchIds         String[] @default([])
    active            Boolean  @default(true)
    customPermissions String[] @default([])

    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    tenantRole        TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
    user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@map("staff_members")
}
